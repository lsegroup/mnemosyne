# mnemosyne server configuration (all optional; sane defaults shown)

# --- corpus / index ---------------------------------------------------------
# MNEMOSYNE_REPO=/srv/mnemosyne            # repo dir holding nodes/ (default: cwd)
# MNEMOSYNE_NODES_DIR=nodes                # subdir with node markdown
# MNEMOSYNE_DB=$MNEMOSYNE_REPO/.mnemosyne/index.db

# --- git write behaviour --------------------------------------------------
# MNEMOSYNE_GIT=true
# MNEMOSYNE_GIT_AUTOCOMMIT=true
# MNEMOSYNE_GIT_PUSH=false
# MNEMOSYNE_GIT_REMOTE=origin
# MNEMOSYNE_GIT_BRANCH=main
# MNEMOSYNE_GIT_AUTHOR_NAME=mnemosyne
# MNEMOSYNE_GIT_AUTHOR_EMAIL=mnemosyne@localhost

# --- embeddings ---------------------------------------------------------
# Leave unset to use the local model (fastembed) or the offline HashEmbedder.
# Set to an OpenAI-compatible gateway (vLLM / LiteLLM / TGI / Ollama compat):
# MNEMOSYNE_EMBED_BASE_URL=http://ai-gw.internal:8000/v1
# MNEMOSYNE_EMBED_API_KEY=
# MNEMOSYNE_EMBED_MODEL=text-embedding-3-small
# MNEMOSYNE_EMBED_DIM=1536

# --- optional chat model (extract / dedupe / /ask) -----------------------
# MNEMOSYNE_LLM_BASE_URL=http://ai-gw.internal:8000/v1
# MNEMOSYNE_LLM_API_KEY=
# MNEMOSYNE_LLM_MODEL=gpt-4o-mini

# --- HTTP server (required for `serve --http`) --------------------------
# MNEMOSYNE_HTTP_HOST=127.0.0.1
# MNEMOSYNE_HTTP_PORT=40000
# MNEMOSYNE_BASE_PATH=/mnemosyne     # all routes mount here so one :40000
#                                     endpoint carries /codegraph, /mnemosyne, ...
MNEMOSYNE_BEARER_TOKEN=change-me

# --- web portal: login screen at <base>/ and admin at <base>/admin/ ---------
# Off until ALL of these are set. MCP/REST are not affected either way.
# Create a GitLab OAuth application (scope: read_user) whose redirect URI is
#   <MNEMOSYNE_PUBLIC_URL><MNEMOSYNE_BASE_PATH>/auth/callback
# MNEMOSYNE_SECRET=<random string, >= 16 chars; signs cookies, encrypts API keys at rest>
# MNEMOSYNE_PUBLIC_URL=https://mnemosyne.example.com:40000
# MNEMOSYNE_GITLAB_URL=https://gitlab.example.com
# MNEMOSYNE_GITLAB_CLIENT_ID=
# MNEMOSYNE_GITLAB_CLIENT_SECRET=
# MNEMOSYNE_ADMIN_USERS=alice,bob@example.com   # GitLab usernames or e-mails; empty = nobody
# MNEMOSYNE_PROVIDERS_FILE=$MNEMOSYNE_REPO/.mnemosyne/providers.enc

# --- Web portal sign-in -------------------------------------------------------
# Built-in admin account, so the portal can be configured before GitLab SSO exists.
# There is NO default account: it exists only if you set a password here. Use a hash
# (preferred) or a plain password. User name defaults to "admin".
#   node -e "import('./packages/server/dist/secrets.js').then(m=>console.log(m.hashPassword(process.argv[1])))" 'your-password'
# MNEMOSYNE_LOCAL_ADMIN_USER=admin
# MNEMOSYNE_LOCAL_ADMIN_PASSWORD_HASH=scrypt$...
# MNEMOSYNE_LOCAL_ADMIN_PASSWORD=
# The built-in account stops working 24h after the first successful GitLab admin sign-in.
# Recovery if GitLab is down or SSO is misconfigured: MNEMOSYNE_LOCAL_ADMIN_FORCE=1
# GitLab SSO (URL, application id/secret, GitLab admins) is entered on the admin page;
# MNEMOSYNE_GITLAB_* / MNEMOSYNE_ADMIN_USERS above are only the fallback values.
